# App
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,https://idice.eso.wootlab.ng

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=eso_user
DB_PASSWORD=eso_pass
DB_NAME=eso_db
# Keep certificate validation on for managed PostgreSQL in production.
DB_SSL_REJECT_UNAUTHORIZED=true

# JWT
JWT_ACCESS_SECRET=replace-with-32-char-minimum-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-32-char-secret
JWT_REFRESH_EXPIRES_IN=7d

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Mail
MAIL_PROVIDER=sendgrid
MAIL_API_KEY=
MAIL_FROM_ADDRESS=noreply@idice.eso.wootlab.ng

# SMS
SMS_PROVIDER=termii
SMS_API_KEY=
SMS_SENDER_ID=iDICE

# Storage
STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=


SYSADMIN_SEED_PASSWORD=YourStrongPasswordHere!

FRONTEND_URL=https://idice.eso.wootlab.ng

# Generate separate random 32-byte keys for local development; never reuse these in production.
MFA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
MFA_ISSUER=iDICE ESO Portal
NIN_HASH_KEY=REPLACE_WITH_A_DIFFERENT_64_HEX_KEY
NIN_ENCRYPTION_KEY=REPLACE_WITH_ANOTHER_64_HEX_KEY


LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_WINDOW_MINUTES=15
LOCKOUT_DURATION_MINUTES=30
